# AbroBiz environment template
# Copy to .env for local development. Every value below is a placeholder.
# Never commit .env, .env.local, or any other environment file.

# PUBLIC — safe for the browser bundle (use only the anon/publishable key)
VITE_SUPABASE_URL=https://qgbvuvxxfogcsvqzncdx.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional branded Supabase Auth hostname after it is verified:
VITE_SUPABASE_AUTH_URL=
VITE_SITE_URL=http://localhost:5173
VITE_PLATFORM_DOMAIN=abrobiz.com
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
VITE_TELEGRAM_BOT_USERNAME=

# SERVER-ONLY — Supabase Edge Functions / server configuration only
# These must never use a VITE_ prefix or be exposed to the browser.
SUPABASE_URL=https://qgbvuvxxfogcsvqzncdx.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
RESEND_API_KEY=YOUR_RESEND_API_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
CLOUDFLARE_ZONE_ID=YOUR_CLOUDFLARE_ZONE_ID
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=YOUR_TELEGRAM_WEBHOOK_SECRET
CRON_SECRET=YOUR_CRON_SECRET

# CONFIGURATION — non-secret deployment settings
APP_NAME=AbroBiz
SITE_URL=https://abrobiz.com
EMAIL_DOMAIN=abrobiz.com
EMAIL_FROM=AbroBiz <noreply@abrobiz.com>
SUPPORT_EMAIL=support@abrobiz.com
SUPPORT_TELEGRAM_USERNAME=
# Comma-separated exact origins. Tenant origins are allowed only by the
# strict one-label https://<tenant>.abrobiz.com rule in the CORS helper.
CORS_ALLOWED_ORIGINS=https://abrobiz.com,https://www.abrobiz.com,http://localhost:5173,http://127.0.0.1:5173
TURNSTILE_ENFORCE=false
TURNSTILE_ALLOWED_HOSTNAMES=abrobiz.com,www.abrobiz.com,*.abrobiz.com

# Optional SMTP fallback (server-only)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_SMTP_USERNAME
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_USE_TLS=true
MAIL_FROM=AbroBiz <noreply@abrobiz.com>

# Optional legacy Gmail fallback (server-only; prefer Resend)
GMAIL_USER=YOUR_GMAIL_USER
GMAIL_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# Local-only test placeholders; use a separate disposable Supabase project.
STAGING_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
STAGING_SUPABASE_ANON_KEY=YOUR_STAGING_SUPABASE_ANON_KEY
