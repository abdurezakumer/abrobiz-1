# Copy this file to .env and fill in your own Supabase project values.
# Find these in your Supabase project: Settings -> API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# After activating the branded Supabase custom domain, use this instead of
# the project URL so OAuth and API requests use auth.abrobiz.com.
# VITE_SUPABASE_AUTH_URL=https://auth.abrobiz.com

# Supabase Edge Function secret (set with `supabase secrets set`, not in the
# browser bundle). Restricts production function CORS to the frontend origin.
# CORS_ORIGINS=https://abrobiz.com,https://www.abrobiz.com,http://localhost:5173,http://127.0.0.1:5173

# Production URL used for OAuth and links. Local development keeps its local origin.
VITE_SITE_URL=https://abrobiz.com
VITE_PLATFORM_DOMAIN=abrobiz.com

# This is the Supabase/Google OAuth callback, not a Flask callback. It must
# use the same project ref as VITE_SUPABASE_URL unless the branded auth domain
# below is active.
GOOGLE_REDIRECT_URI=https://your-project-ref.supabase.co/auth/v1/callback

# These are Supabase Edge Function secrets, not Vite variables. Set them with
# `supabase secrets set` (see SETUP.md) so they never ship to the browser.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=oneabdre@gmail.com
# MAIL_PASSWORD=your-google-app-password
# MAIL_USE_TLS=true
# MAIL_FROM=Abdre <oneabdre@gmail.com>
# For a real @abrobiz.com sender, verify the domain with Resend or another
# authenticated SMTP provider and use these Edge Function secrets instead:
# RESEND_API_KEY=your-resend-api-key
# EMAIL_DOMAIN=abrobiz.com
# EMAIL_FROM=AbroBiz <noreply@abrobiz.com>

# Phase 3 — Telegram bot. Set this once you've created your bot with
# @BotFather (see SETUP.md). It's just the @username, no @ symbol, e.g. "abrobiz_bot".
VITE_TELEGRAM_BOT_USERNAME=
